// A consumer that polls instead of waiting: how many times it found nothing
// depends on how fast the producer ran.

import "std/io"
import "std/mem"

func produce(ch chan[u64]) !void {
    for i in 0..10000 {
        try ch <- u64(i)
    }
}

func drain(ch chan[u64], mut misses *u64) {
    mut got u64 = 0
    mut empty u64 = 0
    for got < 10000 {
        if v := ch.TryRecv() {
            got += 1
        } else {
            empty += 1
        }
    }
    *misses = empty
}

det func polled(mut a mem.Allocator) !u64 {
    ch := try chan[u64](a, 16)
    mut misses u64 = 0
    scope {
        spawn produce(ch)
        spawn drain(ch, &misses)
    }
    return misses
}

func main() !int {
    mut room := [65536]u8{}
    mut arena := mem.NewArena(room[..])
    try io.Printf("{}\n", try polled(&arena))
    return 0
}
