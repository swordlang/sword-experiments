    return o
}

func twiddle8(a [8]Cx, w []Cx, l1 i64) [8]Cx {
    mut o := [8]Cx{}
    mut i1_0 := f32(0.0)
    mut i1_1 := f32(0.0)
    mut i1_2 := f32(0.0)
    mut i1_3 := f32(0.0)
    mut i1_4 := f32(0.0)
    mut i1_5 := f32(0.0)
    mut i1_6 := f32(0.0)
    mut i1_7 := f32(0.0)
    mut i2_0 := f32(0.0)
    mut i2_1 := f32(0.0)
    mut i2_2 := f32(0.0)
