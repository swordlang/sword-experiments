// Cilk-5.4.6 examples/fft.cilk: Cooley-Tukey FFT in float of any length,
// with straight-line codelets for radices 2 to 32.
// Derived from Cilk-5.4.6; see COPYING.
//
// Class: rewritten. fft_aux unshuffles in into out, spawns one transform of
// length m per run of m in out, each using its run of in as its own out,
// then multiplies by the twiddle factors from in into out. Each step halves
// a range of i and spawns the halves. The sub-transforms write a run of in
// and a run of out, and a loop may cut only one slice into pieces, so the two
// arrays are held as one, an element of in beside the element of out, and
// a run of that array is a piece of chunks. Unshuffle and twiddle write
// out at i + j m for the i of their range: a column, not one run. Each
// becomes two parallel loops: the first writes, by i, a scratch array of
// its own in that order, the second copies it into out a row j at a time,
// and a row is a run. compute_w_coefficients writes W at k and at n - k; it
// becomes a parallel loop over W, each element taking the k it comes from.
// The codelets are translated statement by statement, by fftgen.py. Each
// element sees the C's operations in the same order. cos and sin are
// Sword's, in double, rounded to float as the C rounds glibc's. The program
// prints what the C prints and the bits of the transform.
// Args:
// Answer: ^(Options|out bits)
// Patch: s/^     cp_elapsed = Cilk_user_critical_path - cp_begin;/     cp_elapsed = Cilk_user_critical_path - cp_begin; { unsigned long long h = 14695981039346656037ULL; unsigned int w; long q; for (q = 0; q < size; q++) { memcpy(&w, &c_re(out[q]), 4); h = (h ^ w) * 1099511628211ULL; memcpy(&w, &c_im(out[q]), 4); h = (h ^ w) * 1099511628211ULL; } printf("out bits = %llx\\n", h); }/

import "std/io"
import "std/mem"
import "std/num"

struct Cx {
    re f32
    im f32
}

// An element of the C's in and the element of its out at the same place.
// Which of the two is in flips at every level of the recursion.
struct Pair {
    x Cx
    y Cx
}

func inOf(p Pair, flip bool) Cx {
    if flip {
        return p.y
    }
    return p.x
}

func setOut(mut p *Pair, flip bool, v Cx) {
    if flip {
        p.x = v
    } else {
        p.y = v
    }
}

func factor(n i64) i64 {
    if n < 2 {
        return 1
    }
    if n == 64 || n == 128 || n == 256 || n == 1024 || n == 2048 || n == 4096 {
        return 8
    }
    if (n & 15) == 0 {
        return 16
    }
    if (n & 7) == 0 {
        return 8
    }
    if (n & 3) == 0 {
        return 4
    }
    if (n & 1) == 0 {
        return 2
    }
    mut r := i64(3)
    for r < n {
        if n % r == 0 {
            return r
        }
        r += 2
    }
    return n
}

// W[k] and W[n - k] for k from 0 to n / 2, as compute_w_coefficients.
func coefficients(n i64, mut w []Cx) {
    twoPiOverN := 2.0 * 3.1415926535897932384626434 / f64(n)
    parallel for e in 0..w.len {
        ei := i64(e)
        if ei < n - n / 2 {
            w[e] = Cx{re: f32(num.Cos(twoPiOverN * f64(ei))),
                im: -f32(num.Sin(twoPiOverN * f64(ei)))}
        } else {
            k := n - ei
            w[e] = Cx{re: f32(num.Cos(twoPiOverN * f64(k))), im: f32(num.Sin(twoPiOverN * f64(k)))}
        }
    }
}

func base(n i64, mut buf []Pair, flip bool) {
    if n == 2 {
        mut a := [2]Cx{}
        for k in 0..2 {
            a[k] = inOf(buf[k], flip)
        }
        o := base2(a)
        for k in 0..2 {
            setOut(&buf[k], flip, o[k])
        }
    } else if n == 4 {
        mut a := [4]Cx{}
        for k in 0..4 {
            a[k] = inOf(buf[k], flip)
        }
        o := base4(a)
        for k in 0..4 {
            setOut(&buf[k], flip, o[k])
        }
    } else if n == 8 {
        mut a := [8]Cx{}
        for k in 0..8 {
            a[k] = inOf(buf[k], flip)
        }
        o := base8(a)
        for k in 0..8 {
            setOut(&buf[k], flip, o[k])
        }
    } else if n == 16 {
        mut a := [16]Cx{}
        for k in 0..16 {
            a[k] = inOf(buf[k], flip)
        }
        o := base16(a)
        for k in 0..16 {
            setOut(&buf[k], flip, o[k])
        }
    } else {
        mut a := [32]Cx{}
        for k in 0..32 {
            a[k] = inOf(buf[k], flip)
        }
        o := base32(a)
        for k in 0..32 {
            setOut(&buf[k], flip, o[k])
        }
    }
}

// The twiddle of column i: the r elements of in at i + j m, into col.
func column(r i64, buf []Pair, flip bool, i i64, m i64, w []Cx, nW i64, nWdn i64,
    mut col []Cx) {
    l1 := nWdn * i
    if r == 2 {
        mut a := [2]Cx{}
        for j in 0..2 {
            a[j] = inOf(buf[i + j * m], flip)
        }
        o := twiddle2(a, w, l1)
        for j in 0..2 {
            col[j] = o[j]
        }
    } else if r == 4 {
        mut a := [4]Cx{}
        for j in 0..4 {
            a[j] = inOf(buf[i + j * m], flip)
        }
        o := twiddle4(a, w, l1)
        for j in 0..4 {
            col[j] = o[j]
        }
    } else if r == 8 {
        mut a := [8]Cx{}
        for j in 0..8 {
            a[j] = inOf(buf[i + j * m], flip)
        }
        o := twiddle8(a, w, l1)
        for j in 0..8 {
            col[j] = o[j]
        }
    } else if r == 16 {
        mut a := [16]Cx{}
        for j in 0..16 {
            a[j] = inOf(buf[i + j * m], flip)
        }
        o := twiddle16(a, w, l1)
        for j in 0..16 {
            col[j] = o[j]
        }
    } else if r == 32 {
        mut a := [32]Cx{}
        for j in 0..32 {
            a[j] = inOf(buf[i + j * m], flip)
        }
        o := twiddle32(a, w, l1)
        for j in 0..32 {
            col[j] = o[j]
        }
    } else {
        // fft_twiddle_gen1
        nWdntm := nWdn * m
        for k in 0..r {
            mut r0 := f32(0.0)
            mut i0 := f32(0.0)
            lk := l1 + nWdntm * k
            mut l0 := i64(0)
            for j in 0..r {
                rw := w[l0].re
                iw := w[l0].im
                x := inOf(buf[i + j * m], flip)
                r0 += x.re * rw - x.im * iw
                i0 += x.re * iw + x.im * rw
                l0 += lk
                if l0 > nW {
                    l0 -= nW
                }
            }
            col[k] = Cx{re: r0, im: i0}
        }
    }
}

// Writes out at i + j m from scratch, laid out by i: a row j at a time.
func rows(mut buf []Pair, flip bool, scratch []Cx, r i64, m i64) {
    parallel for off, row in buf.chunks(m) {
        j := i64(off) / m
        for i in 0..m {
            setOut(&row[i], flip, scratch[i * r + j])
        }
    }
}

func fftAux(n i64, mut buf []Pair, flip bool, factors [40]i64, fi i64, w []Cx, nW i64,
    fails *atomic[i64]) {
    if n == 32 || n == 16 || n == 8 || n == 4 || n == 2 {
        base(n, buf, flip)
        return
    }
    r := factors[fi]
    m := n / r
    mut heap := mem.NewSystem()
    mut scratch := mem.Alloc[Cx](&heap, u64(n)) orelse { fails.Add(1); return }
    if r < n {
        // unshuffle: out[i + j m] = in[i r + j], by i into scratch first.
        parallel for e in 0..scratch.len {
            scratch[e] = inOf(buf[e], flip)
        }
        rows(buf, flip, scratch, r, m)
        scope {
            for off, part in buf.chunks(m) {
                spawn fftAux(m, part, !flip, factors, fi + 1, w, nW, fails)
            }
        }
    }
    nWdn := nW / n
    parallel for off, col in scratch.chunks(r) {
        column(r, buf, flip, i64(off) / r, m, w, nW, nWdn, col)
    }
    rows(buf, flip, scratch, r, m)
    mem.Free[Cx](&heap, scratch)
}

func main() !int {
    n := i64(1024 * 1024)
    mut heap := mem.NewSystem()
    mut buf := mem.Alloc[Pair](&heap, u64(n)) orelse return error.OutOfMemory
    mut w := mem.Alloc[Cx](&heap, u64(n + 1)) orelse return error.OutOfMemory
    for i in 0..buf.len {
        buf[i] = Pair{x: Cx{re: 1.0, im: 1.0}, y: Cx{re: 0.0, im: 0.0}}
    }
    coefficients(n, w)
    mut factors := [40]i64{}
    mut l := n
    mut p := i64(0)
    for {
        r := factor(l)
        factors[p] = r
        p += 1
        l /= r
        if l <= 1 {
            break
        }
    }
    mut fails := atomic[i64](0)
    fftAux(n, buf, false, factors, 0, w, n, &fails)
    if fails.Load() > 0 {
        return error.OutOfMemory
    }
    mut h := u64(14695981039346656037)
    for i in 0..buf.len {
        mut re := buf[i].y.re
        mut im := buf[i].y.im
        a := [*]u32(&re)
        b := [*]u32(&im)
        h = (h ^ u64(a[0])) *% 1099511628211
        h = (h ^ u64(b[0])) *% 1099511628211
    }
    try io.Printf("out bits = {x}\n", h)
    try io.Printf("Options:  number of elements   n = {}\n", n)
    return 0
}

// What follows is fft.cilk's machine-generated code, translated by
// fftgen.py statement by statement.

func base2(a [2]Cx) [2]Cx {
    mut o := [2]Cx{}
    mut i1_0 := f32(0.0)
    mut i1_1 := f32(0.0)
    mut r1_0 := f32(0.0)
    mut r1_1 := f32(0.0)
    r1_0 = a[0].re
    i1_0 = a[0].im
    r1_1 = a[1].re
    i1_1 = a[1].im
    o[0].re = (r1_0 + r1_1)
    o[0].im = (i1_0 + i1_1)
    o[1].re = (r1_0 - r1_1)
    o[1].im = (i1_0 - i1_1)
    return o
}

func twiddle2(a [2]Cx, w []Cx, l1 i64) [2]Cx {
    mut o := [2]Cx{}
    mut i1_0 := f32(0.0)
    mut i1_1 := f32(0.0)
    mut r1_0 := f32(0.0)
    mut r1_1 := f32(0.0)
    mut tmpi := f32(0.0)
    mut tmpr := f32(0.0)
    mut wi := f32(0.0)
    mut wr := f32(0.0)
    r1_0 = a[0].re
    i1_0 = a[0].im
    wr = w[1 * l1].re
    wi = w[1 * l1].im
    tmpr = a[1].re
    tmpi = a[1].im
    r1_1 = ((wr * tmpr) - (wi * tmpi))
    i1_1 = ((wi * tmpr) + (wr * tmpi))
    o[0].re = (r1_0 + r1_1)
    o[0].im = (i1_0 + i1_1)
    o[1].re = (r1_0 - r1_1)
    o[1].im = (i1_0 - i1_1)
    return o
}

func base4(a [4]Cx) [4]Cx {
    mut o := [4]Cx{}
    mut i1_0 := f32(0.0)
    mut i1_1 := f32(0.0)
    mut i1_2 := f32(0.0)
    mut i1_3 := f32(0.0)
    mut i2_0 := f32(0.0)
    mut i2_1 := f32(0.0)
    mut i2_2 := f32(0.0)
    mut i2_3 := f32(0.0)
    mut r1_0 := f32(0.0)
    mut r1_1 := f32(0.0)
    mut r1_2 := f32(0.0)
    mut r1_3 := f32(0.0)
    mut r2_0 := f32(0.0)
    mut r2_1 := f32(0.0)
    mut r2_2 := f32(0.0)
    mut r2_3 := f32(0.0)
    r2_0 = a[0].re
    i2_0 = a[0].im
    r2_2 = a[2].re
    i2_2 = a[2].im
    r1_0 = (r2_0 + r2_2)
    i1_0 = (i2_0 + i2_2)
    r1_2 = (r2_0 - r2_2)
    i1_2 = (i2_0 - i2_2)
    r2_1 = a[1].re
    i2_1 = a[1].im
    r2_3 = a[3].re
    i2_3 = a[3].im
    r1_1 = (r2_1 + r2_3)
    i1_1 = (i2_1 + i2_3)
    r1_3 = (r2_1 - r2_3)
    i1_3 = (i2_1 - i2_3)
    o[0].re = (r1_0 + r1_1)
    o[0].im = (i1_0 + i1_1)
    o[2].re = (r1_0 - r1_1)
    o[2].im = (i1_0 - i1_1)
    o[1].re = (r1_2 + i1_3)
    o[1].im = (i1_2 - r1_3)
    o[3].re = (r1_2 - i1_3)
    o[3].im = (i1_2 + r1_3)
    return o
}

func twiddle4(a [4]Cx, w []Cx, l1 i64) [4]Cx {
    mut o := [4]Cx{}
    mut i1_0 := f32(0.0)
    mut i1_1 := f32(0.0)
    mut i1_2 := f32(0.0)
    mut i1_3 := f32(0.0)
    mut i2_0 := f32(0.0)
    mut i2_1 := f32(0.0)
    mut i2_2 := f32(0.0)
    mut i2_3 := f32(0.0)
    mut r1_0 := f32(0.0)
    mut r1_1 := f32(0.0)
    mut r1_2 := f32(0.0)
    mut r1_3 := f32(0.0)
    mut r2_0 := f32(0.0)
    mut r2_1 := f32(0.0)
    mut r2_2 := f32(0.0)
    mut r2_3 := f32(0.0)
    mut tmpi := f32(0.0)
    mut tmpr := f32(0.0)
    mut wi := f32(0.0)
    mut wr := f32(0.0)
    r2_0 = a[0].re
    i2_0 = a[0].im
    wr = w[2 * l1].re
    wi = w[2 * l1].im
    tmpr = a[2].re
    tmpi = a[2].im
    r2_2 = ((wr * tmpr) - (wi * tmpi))
    i2_2 = ((wi * tmpr) + (wr * tmpi))
    r1_0 = (r2_0 + r2_2)
    i1_0 = (i2_0 + i2_2)
    r1_2 = (r2_0 - r2_2)
    i1_2 = (i2_0 - i2_2)
    wr = w[1 * l1].re
    wi = w[1 * l1].im
    tmpr = a[1].re
    tmpi = a[1].im
    r2_1 = ((wr * tmpr) - (wi * tmpi))
    i2_1 = ((wi * tmpr) + (wr * tmpi))
    wr = w[3 * l1].re
    wi = w[3 * l1].im
    tmpr = a[3].re
    tmpi = a[3].im
    r2_3 = ((wr * tmpr) - (wi * tmpi))
    i2_3 = ((wi * tmpr) + (wr * tmpi))
    r1_1 = (r2_1 + r2_3)
    i1_1 = (i2_1 + i2_3)
    r1_3 = (r2_1 - r2_3)
    i1_3 = (i2_1 - i2_3)
    o[0].re = (r1_0 + r1_1)
    o[0].im = (i1_0 + i1_1)
    o[2].re = (r1_0 - r1_1)
    o[2].im = (i1_0 - i1_1)
    o[1].re = (r1_2 + i1_3)
    o[1].im = (i1_2 - r1_3)
    o[3].re = (r1_2 - i1_3)
    o[3].im = (i1_2 + r1_3)
    return o
}

