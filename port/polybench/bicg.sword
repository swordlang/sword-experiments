// PolyBench/C 4.2.1 bicg, SMALL_DATASET: s := A^T r, q := A p.
// Derived from PolyBench/C; see LICENSE.txt.
//
// Class: as is. The main nest has no parallel loop: i carries s[j] and j
// carries the sum into q[i]. The loop clearing s is parallel, and stays so.

import "std/mem"
import "pb"

const M = 116
const N = 124

func kernel(a []f64, r []f64, p []f64, mut s []f64, mut q []f64) {
    parallel for i in 0..s.len {
        s[i] = 0.0
    }
    for i in 0..N {
        q[i] = 0.0
        for j in 0..M {
            s[j] = s[j] + r[i] * a[i * M + j]
            q[i] = q[i] + a[i * M + j] * p[j]
        }
    }
}

func main() !int {
    mut heap := mem.NewSystem()
    mut a := mem.Alloc[f64](&heap, N * M) orelse return error.OutOfMemory
    mut r := mem.Alloc[f64](&heap, N) orelse return error.OutOfMemory
    mut p := mem.Alloc[f64](&heap, M) orelse return error.OutOfMemory
    mut s := mem.Alloc[f64](&heap, M) orelse return error.OutOfMemory
    mut q := mem.Alloc[f64](&heap, N) orelse return error.OutOfMemory
    for i in 0..M {
        p[i] = f64(i % M) / f64(M)
    }
    for i in 0..N {
        r[i] = f64(i % N) / f64(N)
        for j in 0..M {
            a[i * M + j] = f64(i * (j + 1) % N) / f64(N)
        }
    }
    kernel(a, r, p, s, q)
    try pb.Dump("s", s)
    try pb.Dump("q", q)
    return 0
}
