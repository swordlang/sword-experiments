// PolyBench/C 4.2.1 covariance, SMALL_DATASET: the covariance matrix of N
// samples of M variables.
// Derived from PolyBench/C; see LICENSE.txt.
//
// Class: rewritten. The j loop of the means writes only mean[j], as is. The
// centering i loop writes row i of data, a piece of data.chunks(M). The last
// i loop writes row i of cov from the diagonal on, and column i below it,
// which no other i touches; Sword cuts a slice into rows only, so the rows
// are computed into a temporary and the lower half copied across from it.

import "std/mem"
import "pb"

const M = 80
const N = 100

func kernel(fln f64, mut data []f64, mut cov []f64, mut up []f64, mut mean []f64) {
    parallel for j in 0..mean.len {
        mean[j] = 0.0
        for i in 0..N {
            mean[j] += data[i * M + i64(j)]
        }
        mean[j] /= fln
    }
    parallel for off, row in data.chunks(M) {
        for j in 0..M {
            row[j] -= mean[j]
        }
    }
    parallel for off, row in up.chunks(M) {
        i := i64(off) / M
        for j in i..M {
            row[j] = 0.0
            for k in 0..N {
                row[j] += data[k * M + i] * data[k * M + j]
            }
            row[j] /= (fln - 1.0)
        }
    }
    parallel for off, row in cov.chunks(M) {
        i := i64(off) / M
        for j in 0..M {
            if j >= i {
                row[j] = up[i * M + j]
            } else {
                row[j] = up[j * M + i]
            }
        }
    }
}

func main() !int {
    mut heap := mem.NewSystem()
    mut data := mem.Alloc[f64](&heap, N * M) orelse return error.OutOfMemory
    mut cov := mem.Alloc[f64](&heap, M * M) orelse return error.OutOfMemory
    mut up := mem.Alloc[f64](&heap, M * M) orelse return error.OutOfMemory
    mut mean := mem.Alloc[f64](&heap, M) orelse return error.OutOfMemory
    for i in 0..N {
        for j in 0..M {
            data[i * M + j] = (f64(i) * f64(j)) / f64(M)
        }
    }
    kernel(f64(N), data, cov, up, mean)
    try pb.Dump("cov", cov)
    return 0
}
